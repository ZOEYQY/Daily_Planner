# Copy to .env (git-ignored) for local development with `docker compose up -d postgres`.
# These credentials only work for the local Docker database. Never put real
# Render credentials in any committed file; set them in the Render dashboard.
DATABASE_URL=postgresql+psycopg://daily_planner:local-dev-password@localhost:5432/daily_planner
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
