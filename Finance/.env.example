# Copy this file to Finance/.env and fill in your key.
# Finance/.env is git-ignored; this .example file is safe to commit.

# Powers the AI features in Finance, all optional — without a key the
# buttons just return a "not configured" message and everything else works:
#   * "Extract details with AI" on the Add / Update record forms
#   * "Ask AI whether to buy" on each Shopping List item
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override the OpenAI model used for both features above.
# OPENAI_RECEIPT_MODEL=gpt-4o-mini
