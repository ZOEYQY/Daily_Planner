# Copy this file to Finance/.env and fill in your key.
# Finance/.env is git-ignored; this .example file is safe to commit.

# Required for the "Extract details with AI" button on the Add/Update forms.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override the vision model used for receipt extraction.
# OPENAI_RECEIPT_MODEL=gpt-4o-mini
